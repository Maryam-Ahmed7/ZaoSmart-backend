generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String
  countryCode   String         @default("")
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  devices       Device[]
  refreshTokens RefreshToken[]
  farms         Farm[]
  scans         Scan[]
  reminders     Reminder[]
  subscription  Subscription?
}

model Device {
  id            String         @id @default(uuid())
  name          String         // stores the client deviceId UUID
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cropType  String
  location  String?
  sizeHa    Float?
  notes     String?
  scans     Scan[]
  reminders Reminder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model Scan {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId           String?
  farm             Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  diseaseId        String?
  disease          Disease? @relation(fields: [diseaseId], references: [id], onDelete: SetNull)
  cropType         String
  predictedDisease String?
  confidence       Float?
  confidenceTier   String?
  severity         String?
  isPremiumResult  Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([farmId])
  @@index([diseaseId])
}

model Disease {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  cropType    String
  severity    String
  symptoms    String
  treatment   String
  isActive    Boolean  @default(true)
  scans       Scan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cropType])
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId      String?
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropId      String?
  title       String
  scheduledAt DateTime
  isCompleted Boolean  @default(false)
  recurrence  String?  // "daily" | "weekly" | "none" | null
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([farmId])
  @@index([scheduledAt])
}

model Subscription {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String    @default("free")
  status     String    @default("active")
  startDate  DateTime  @default(now())
  expiryDate DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([expiryDate])
}
